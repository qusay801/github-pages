<!-- index.html -->
  <!DOCTYPE html>
  <html>
    <head>
      <title>My Mini App</title>
      <script src="https://telegram.org/js/telegram-web-app.js"></script>
    </head>
    <body>
      <h1>مرحبًا بك في تطبيقي!</h1>
      <button onclick="sendData()">إرسال بيانات إلى البوت</button>
      <script>
        const tg = window.Telegram.WebApp;
        tg.expand(); // توسيع الواجهة لملء الشاشة

        function sendData() {
          tg.sendData("تم النقر على الزر!");
          tg.close(); // إغلاق التطبيق بعد الإرسال
        }
      </script>
    </body>
  </html>
